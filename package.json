{
  "name": "sasang",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "pnpm --filter @sasang/app start",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "map:generate": "node scripts/map-data/generate-maps.mjs",
    "map:test": "node --test scripts/map-data/*.test.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "pnpm": "10.34.5",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.6.2",
    "turbo": "^2.10.7",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23"
    }
  }
}
